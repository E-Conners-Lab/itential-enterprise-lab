# Copy to .env (gitignored). Every value here is read by make/tofu/ansible/verify.
PROXMOX_VE_ENDPOINT=https://192.168.68.161:8006/
PROXMOX_VE_API_TOKEN=            # tofu@pve!tofu=uuid, minted by ansible/playbooks/pve-host-prep.yml (phase 2)
PROXMOX_VE_INSECURE=true         # self-signed host certificate
PROXMOX_VE_SSH_USERNAME=root
EVE_HOST=192.168.68.240
EVE_USERNAME=admin
EVE_PASSWORD=                    # rotated off the factory value by ansible/playbooks/eve-password.yml (phase 2)
NETBOX_URL=http://192.168.68.110:8080
NETBOX_TOKEN=                    # v2 token nbt_<key>.<secret>, minted by ansible/playbooks/netbox-token.yml (phase 2)
IMAGE_STAGING=/srv/images        # on the Proxmox host
KUBECONFIG_PATH=                 # default ~/.kube/lab-k3s.yaml, written by ansible/playbooks/k3s-cluster.yml (phase 3)
HELM3_BIN=                       # default /opt/homebrew/opt/helm@3/bin/helm (kubernetes.core drives Helm 3 only)
AUTOMATION_PASSWORD=             # device-local 'automation' account on every lab node (phase 4; Vault in phase 9)
WIN_LAB_PASSWORD=                # local 'lab' user baked into the Windows 11 client image (phase 4)
ARISTA_TOKEN=                    # arista.com profile API token for images/fetch.sh arista (optional)
# --- Phase 5: Itential (itential/README.md) ---
ECR_AWS_PROFILE=itential-ecr     # ~/.aws/config profile backed by the company AWS SSO (`aws sso login --profile itential-ecr`)
ECR_AWS_ACCESS_KEY_ID=           # fallback: temporary keys pasted from the SSO portal instead of the profile
ECR_AWS_SECRET_ACCESS_KEY=
ECR_AWS_SESSION_TOKEN=
ITENTIAL_ENCRYPTION_KEY=         # 64 hex chars, generated once by ansible/playbooks/itential.yml (persisted here before first use; losing it loses every stored adapter secret)
ITENTIAL_ADMIN_USER=admin@itential # dev-stack OpenLDAP admin (Gateway Manager honours its group); the built-in local 'admin' shares the password
ITENTIAL_ADMIN_PASSWORD=         # dev-stack default 'admin'; owner keeps it (accepted SEC exception, lab OOB only); the MCP server uses the same login
SNOW_INSTANCE=                   # ServiceNow PDI name, e.g. dev123456 (never the password in docs)
SNOW_USER=                       # PDI integration user for adapter-servicenow (basic auth)
SNOW_PASSWORD=
# --- Phase 6: FlowAI (ADR 0037) ---
ANTHROPIC_API_KEY=               # Model Registry profile 'anthropic' (write-only in the platform); single-quote it in .env
# --- Phase 7: observability (ADR 0051); each is generated once by ansible/playbooks/observability.yml and persisted here before use ---
ZABBIX_ADMIN_PASSWORD=           # Zabbix 'Admin' (the play rotates the stock 'zabbix' password on first run)
ZABBIX_GRAFANA_PASSWORD=         # read-only Zabbix user 'grafana' for the Grafana datasource
GRAFANA_ADMIN_PASSWORD=          # Grafana 'admin' (Keycloak SSO in phase 9)
SNMPV3_AUTH_PASSWORD=            # SNMPv3 user 'zabbix' on every router and switch (SHA); pushed through wf-config-push-v1 only
SNMPV3_PRIV_PASSWORD=            # SNMPv3 privacy passphrase (AES-128)
# --- Phase 8: production Itential environment, HA2 shape (ADR 0053); generated once by
# ansible/playbooks/platform-ha2-*.yml and persisted here before use ---
MONGO_KEYFILE=                   # 1024-char base64 shared secret for MongoDB intra-cluster authentication
MONGO_ADMIN_PASSWORD=            # MongoDB root account
MONGO_ITENTIAL_PASSWORD=         # the Platform's MongoDB account (readWrite on the itential database)
MONGO_MONITOR_PASSWORD=          # clusterMonitor account for mongodb_exporter (the official dashboard)
# S11.9 (ADR 0058): the nightly mongodump account - MongoDB's built-in `backup` role, generated on first run
MONGO_BACKUP_PASSWORD=
REDIS_ITENTIAL_PASSWORD=         # the Platform's Redis ACL user
REDIS_REPL_PASSWORD=             # Redis replication user
REDIS_SENTINEL_PASSWORD=         # Redis Sentinel user
REDIS_MONITOR_PASSWORD=          # read-only ACL user for redis_exporter (the official dashboard)
