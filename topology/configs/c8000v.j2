{#- IOS XE baseline for every C8000v (ADR 0034, amended after vendor research 2026-09-06):
    management VRF, NETCONF/RESTCONF, automation user.
    isp-core01 (AS 65000): eBGP hub with default-originate to every site (simulated provider).
    site routers: ISP peering sits in front-door VRF WAN (Cisco FlexVPN/IWAN transport pattern);
      IKEv2 tunnels (routing.wan_tunnel_mode: gre = GRE-over-IPsec with tunnel protection,
      ipsec = FlexVPN static VTI) with NGE ciphers (aes-gcm-256 / prf sha384 / group 19, esp-gcm 256)
      terminate in global with BGP inside the tunnels.
    dc1-wan01/02 (AS 65100): iBGP between them; per-router routed /30 + eBGP to each firewall
      (GR helper, BFD) - or, while lab.firewalls is false, to a leaf in VRF PROD (bypass links).
    brN-wan01 (AS 6520N): tunnels to both DC edges; the firewall is the LAN gateway - or, while
      bypassed, the router's spare port is the VLAN 10 gateway with a DHCP pool. -#}
{%- set site = node.site %}
{#- lo, asn, isp_peer, wan_ip, lan, tunnels, ibgp, agg, isp_neighbors come from topology/derive.py (ADR 0048) -#}
{#- routed eBGP neighbours on this router's links: firewalls (AS from routing) and leaf bypass (AS dc1_leaf) -#}
{%- set ns = namespace(ebgp=[], links=[]) %}
{%- set ns.links = [] %}
{%- for lk in links %}
{%- set other = (lk.b if lk.a.startswith(name + ':') else lk.a).split(':')[0] %}
{%- if firewalls or nodes[other].role != 'firewall' %}{% set ns.links = ns.links + [lk] %}{% endif %}
{%- endfor %}
{%- for lk in ns.links if lk.prefix is defined %}
{%- set mine = lk.a if lk.a.startswith(name + ':') else lk.b %}
{%- set peer = (lk.b if mine == lk.a else lk.a).split(':')[0] %}
{%- set base = lk.prefix.split('/')[0].split('.') %}
{%- set last = base[3] | int %}
{%- set nbr_ip = base[0] ~ '.' ~ base[1] ~ '.' ~ base[2] ~ '.' ~ ((last + 2) if mine == lk.a else (last + 1)) %}
{%- if peer.startswith('dc1-fw') %}{% set ns.ebgp = ns.ebgp + [{'ip': nbr_ip, 'as': routing.asn.dc1_fw, 'desc': peer}] %}
{%- elif peer.startswith('dc1-leaf') %}{% set ns.ebgp = ns.ebgp + [{'ip': nbr_ip, 'as': routing.asn.dc1_leaf, 'desc': peer ~ ' (firewall bypass)'}] %}
{%- endif %}
{%- endfor %}
hostname {{ name }}
{#- the image boots with an empty licence level, which hides every crypto/IKEv2 command; the level
    takes effect on the next boot, so eve/build.py push-configs reloads the routers once (ADR 0034). -#}
license boot level network-advantage addon dna-advantage
ip domain name {{ lab.domain }}
no ip domain lookup
username automation privilege 15 secret 0 {{ automation_password }}
enable secret 0 {{ automation_password }}
aaa new-model
aaa authentication login default local
aaa authorization exec default local
ip ssh version 2
ip ssh server algorithm hostkey rsa-sha2-512 rsa-sha2-256
crypto key generate rsa modulus 2048
netconf-yang
restconf
ip http secure-server
ip http authentication local
ip name-server vrf MGMT {{ lab.dns | join(' ') }}
ntp server vrf MGMT {{ lab.ntp }}
!
vrf definition MGMT
 address-family ipv4
!
{%- if site != 'wan' %}
vrf definition WAN
 description front-door VRF: provider transport only
 rd {{ asn }}:1
 address-family ipv4
!
{%- endif %}
interface GigabitEthernet1
 description OOB management (pnet1)
 vrf forwarding MGMT
 ip address {{ node.mgmt_ip }} 255.255.255.0
 no shutdown
!
ip route vrf MGMT 0.0.0.0 0.0.0.0 {{ lab.mgmt_gateway }}
!
interface Loopback0
 ip address {{ lo }} 255.255.255.255
!
{%- if lan and not firewalls %}
ip dhcp excluded-address {{ lan.gw }} {{ lan.net[:-1] }}99
ip dhcp pool USERS
 network {{ lan.net }} 255.255.255.0
 default-router {{ lan.gw }}
 dns-server {{ lab.dns | join(' ') }}
 domain-name {{ lab.domain }}
!
{%- endif %}
{%- for lk in ns.links %}
{%- set mine = lk.a if lk.a.startswith(name + ':') else lk.b %}
{%- set peer = lk.b if mine == lk.a else lk.a %}
{%- set ifname = mine.split(':')[1] | replace('Gi', 'GigabitEthernet') %}
{%- set pname = peer.split(':')[0] %}
interface {{ ifname }}
 description to {{ peer }}{{ ' (firewall bypass)' if lk.get('bypass') else '' }}
{%- if lk.prefix is defined %}
{%- set base = lk.prefix.split('/')[0].split('.') %}
{%- set last = base[3] | int %}
{%- set my_last = (last + 1) if mine == lk.a else (last + 2) %}
{%- if pname == 'isp-core01' %}
 vrf forwarding WAN
{%- endif %}
 ip address {{ base[0] }}.{{ base[1] }}.{{ base[2] }}.{{ my_last }} 255.255.255.252
{%- if pname.startswith('dc1-fw') or pname.startswith('dc1-leaf') %}
 bfd interval 300 min_rx 300 multiplier 3
{%- endif %}
{%- elif lk.vlan is defined %}
 ip address {{ lan.gw }} 255.255.255.0
{%- endif %}
 no shutdown
!
{%- endfor %}
{%- if tunnels %}
crypto ikev2 proposal LAB
 encryption aes-gcm-256
 prf sha384
 group 19
!
crypto ikev2 policy LAB
 match fvrf WAN
 proposal LAB
!
crypto ikev2 keyring LAB
{%- for t in tunnels %}
 peer {{ t.peer }}
  address {{ t.dst }}
  pre-shared-key {{ automation_password }}
{%- endfor %}
!
crypto ikev2 profile LAB
 match fvrf WAN
 match identity remote address 0.0.0.0
 authentication remote pre-share
 authentication local pre-share
 keyring local LAB
 dpd 30 5 on-demand
!
crypto ipsec transform-set LAB esp-gcm 256
 mode {{ 'tunnel' if routing.wan_tunnel_mode == 'ipsec' else 'transport' }}
!
crypto ipsec profile LAB
 set transform-set LAB
 set ikev2-profile LAB
!
{%- for t in tunnels %}
interface Tunnel{{ t.id }}
 description {{ 'FlexVPN sVTI' if routing.wan_tunnel_mode == 'ipsec' else 'GRE-over-IPsec' }} to {{ t.peer }}
 ip address {{ t.ip }} 255.255.255.252
 ip mtu 1400
 ip tcp adjust-mss 1360
 tunnel source {{ wan_ip }}
{%- if routing.wan_tunnel_mode == 'ipsec' %}
 tunnel mode ipsec ipv4
{%- endif %}
 tunnel destination {{ t.dst }}
 tunnel vrf WAN
 tunnel protection ipsec profile LAB
!
{%- endfor %}
{%- endif %}
router bgp {{ asn }}
 bgp router-id {{ lo }}
 bgp log-neighbor-changes
 bgp graceful-restart
{%- if node.role == 'isp-core' %}
{%- for n in isp_neighbors %}
 neighbor {{ n.ip }} remote-as {{ n.as }}
{%- endfor %}
 address-family ipv4
  network {{ lo }} mask 255.255.255.255
{%- for n in isp_neighbors %}
  neighbor {{ n.ip }} activate
  neighbor {{ n.ip }} default-originate
{%- endfor %}
 exit-address-family
{%- else %}
{%- for t in tunnels %}
 neighbor {{ t.nbr }} remote-as {{ t.ras }}
 neighbor {{ t.nbr }} description {{ t.peer }} via Tunnel{{ t.id }}
 neighbor {{ t.nbr }} timers 20 60
{%- endfor %}
{%- for e in ns.ebgp %}
 neighbor {{ e.ip }} remote-as {{ e.as }}
 neighbor {{ e.ip }} description {{ e.desc }}
 neighbor {{ e.ip }} fall-over bfd
{%- endfor %}
{%- if site == 'dc1' %}
 neighbor {{ ibgp }} remote-as {{ routing.asn.dc1_edge }}
 neighbor {{ ibgp }} description iBGP dc1 edge peer
{%- endif %}
 address-family ipv4
  network {{ lo }} mask 255.255.255.255
  network {{ agg.net }} mask {{ agg.mask }}
{%- if site == 'dc1' %}
  neighbor {{ ibgp }} activate
  neighbor {{ ibgp }} next-hop-self
{%- endif %}
{%- for t in tunnels %}
  neighbor {{ t.nbr }} activate
{%- endfor %}
{%- for e in ns.ebgp %}
  neighbor {{ e.ip }} activate
{%- endfor %}
 exit-address-family
 address-family ipv4 vrf WAN
  neighbor {{ isp_peer }} remote-as {{ routing.asn.isp }}
  neighbor {{ isp_peer }} description provider (transport only)
  neighbor {{ isp_peer }} activate
 exit-address-family
{%- endif %}
!
{%- if agg %}
ip route {{ agg.net }} {{ agg.mask }} Null0 250
{%- endif %}
!
end
