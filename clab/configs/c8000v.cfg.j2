{# IOS XE startup config for a clab C8000v (ADR 0063), rendered per node by clab-dev.yml from clab/versions.yaml.
    vrnetlab prepends its own bootstrap (hostname, its admin user, GigabitEthernet1 in VRF clab-mgmt with the
    containerlab mgmt address), so this file never touches GigabitEthernet1.
    Inputs: the oracle, `node` (one nodes[] row) and `clab_password` (CLAB_AUTOMATION_PASSWORD, never a literal). -#}
{% set masks = {'24': '255.255.255.0', '31': '255.255.255.254', '32': '255.255.255.255'} %}
{% set wildcards = {'22': '0.0.3.255', '24': '0.0.0.255', '32': '0.0.0.0'} %}
{% set twin_router = aws_twin is defined and node.name == aws_twin.router %}
{% set by_name = {} %}
{% for n in nodes %}{% set _ = by_name.update({n.name: n}) %}{% endfor -%}
hostname {{ node.name }}
{# 17.13.01a boots with an empty licence level (lab-build-lessons); vrnetlab's install step sets
    network-premier. The level takes effect on the next boot, so clab-dev.yml writes memory and reloads each
    router once when `show version` is not yet network-advantage. #}
license boot level network-advantage addon dna-advantage
ip domain name lab.internal
no ip domain lookup
username {{ credentials.user }} privilege 15 secret 0 {{ clab_password }}
{# vrnetlab's bootstrap creates admin/admin (containerlab's default credentials), stored in plain text (IOS type 0),
    and appends this file after it. IOS-XE will not give a `secret` to a user that already has a `password`, so a
    bare `username admin ... secret` line was silently refused and admin/admin kept working on both routers until
    2026-09-23 (ADR 0065). The vendor user is removed first; PID S10.7 (verify/test-12a-clab-dev.sh) proves
    admin/admin is refused on every node, so a rebuild that brings it back fails the verify. #}
no username admin
username admin privilege 15 secret 0 {{ clab_password }}
aaa new-model
aaa authentication login default local
aaa authorization exec default local
ip ssh version 2
line vty 0 4
 login authentication default
 transport input ssh
{% if twin_router %}
 access-class MGMT-ONLY in vrf-also
line vty 5 15
 access-class MGMT-ONLY in vrf-also
{% endif %}
!
{% if twin_router %}
{% set fd = aws_twin.front_door %}
{% set fd_addr, fd_plen = fd.ip.split('/') %}
{# The lab edge's prerequisites for Hand Off AWS VPN (itential-enterprise-lab step 6; spec section 5), as dc1-wan01 will
    carry them: lab-edge's precheck reads each one. The management plane admits only access_allow and the clab host's
    own bridge address; the archive has the path the revert timer needs and hides keys; the zones exist with the
    transit interfaces in INSIDE; the front door is VRF INET with INET-IN closed (slots 20/30 hold the placeholders the
    Hand Off block swaps for IKE from the peer). Turning on AES encryption of stored keys, and the master one, are the
    owner's steps (spec Appendix A); CANARY exists so the precheck can see keys stored as type 6 once those are set: a
    throwaway value (aws_twin.canary_key) for a peer that does not exist (TEST-NET-1). #}
{# vrnetlab (no CLAB_MGMT_PASSTHROUGH) forwards SSH into the VM through QEMU's user network: IOS sees every login - the
    play's devcmd, the Gateway, the Mac - from 10.0.0.2, so that entry is what lets them in, and the clab VM's DOCKER-USER
    allowlist (access_allow) is the real source filter here. The real sources stay listed for a passthrough setup. #}
ip access-list standard MGMT-ONLY
 permit 10.0.0.2 0.0.0.0
{% for src in access_allow + [mgmt.gateway ~ '/32'] %}
{% set net, plen = src.split('/') %}
 permit {{ net }} {{ wildcards[plen] }}
{% endfor %}
!
{# NETCONF and RESTCONF do not use the vty lines (vrnetlab's base config enables both): their own service-level ACLs #}
netconf-yang ssh ipv4 access-list name MGMT-ONLY
restconf ipv4 access-list name MGMT-ONLY
!
{# No `log config`: IOS-XE's config-change log keeps each command as typed, and `hidekeys` does NOT mask an IKEv2
   keyring's PSK line - on dc1-wan01 a Hand Off was logged with its PSK in clear (leak sweep,
   2026-10-01). The revert timer needs only the path; the change history is the Platform's (jobs, backups). -#}
archive
 path bootflash:rb-
 maximum 5
!
crypto ikev2 keyring CANARY
 peer canary
  address 192.0.2.1
  pre-shared-key {{ aws_twin.canary_key }}
!
zone security INSIDE
zone security AWS
!
vrf definition {{ fd.vrf }}
 address-family ipv4
 exit-address-family
!
ip access-list extended INET-IN
 10 deny ip any any fragments
 20 deny udp any host {{ fd_addr }} eq isakmp log
 30 deny udp any host {{ fd_addr }} eq non500-isakmp log
 40 permit icmp any host {{ fd_addr }} echo-reply
 50 permit icmp any host {{ fd_addr }} unreachable
 60 permit icmp any host {{ fd_addr }} time-exceeded
 1000 deny ip any any log
!
interface {{ fd.ifname }}
 description front door to {{ aws_twin.nat.name }} (the twin's stand-in for the internet)
 vrf forwarding {{ fd.vrf }}
 ip address {{ fd_addr }} {{ masks[fd_plen] }}
 ip access-group INET-IN in
 no ip unreachables
 no ip redirects
 no ip proxy-arp
 no shutdown
!
{% endif %}
interface Loopback0
 ip address {{ node.loopback }} 255.255.255.255
 ip ospf {{ routing.ospf.process }} area {{ routing.ospf.area }}
!
{% for link in links %}
{% for side, peer in [(link.a, link.b), (link.b, link.a)] if side.node == node.name and side.ip is defined %}
{% set addr, plen = side.ip.split('/') %}
interface {{ side.ifname }}
 description to {{ peer.node }}:{{ peer.ifname }}
 ip address {{ addr }} {{ masks[plen] }}
 ip ospf network point-to-point
 ip ospf {{ routing.ospf.process }} area {{ routing.ospf.area }}
{% if twin_router %}
 zone-member security INSIDE
{% endif %}
 no shutdown
!
{% endfor %}
{% endfor %}
router ospf {{ routing.ospf.process }}
 router-id {{ node.loopback }}
!
router bgp {{ node.asn }}
 bgp router-id {{ node.loopback }}
 bgp log-neighbor-changes
{% for s in routing.bgp if node.name in [s.a, s.b] %}
{% set peer_name = s.b if s.a == node.name else s.a %}
{% set peer_ip = s.b_ip if s.a == node.name else s.a_ip %}
 neighbor {{ peer_ip }} remote-as {{ by_name[peer_name].asn }}
 neighbor {{ peer_ip }} description {{ peer_name }} ({{ s.type }})
{% if s.type == 'ibgp' %}
 neighbor {{ peer_ip }} update-source Loopback0
{% endif %}
{% endfor %}
 address-family ipv4
{% for s in routing.bgp if node.name in [s.a, s.b] %}
{% set peer_ip = s.b_ip if s.a == node.name else s.a_ip %}
  neighbor {{ peer_ip }} activate
{% if s.type == 'ibgp' %}
  neighbor {{ peer_ip }} next-hop-self
{% endif %}
{% endfor %}
{% for p in routing.announce.get(node.name, []) %}
{% set net, plen = p.split('/') %}
  network {{ net }} mask {{ masks[plen] }}
{% endfor %}
 exit-address-family
!
end
