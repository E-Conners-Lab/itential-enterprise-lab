          },
          {
            "name": "sysparm_limit",
            "in": "query",
            "required": false,
            "description": "Maximum records",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sysparm_fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated fields to return",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sysparm_display_value",
            "in": "query",
            "required": false,
            "description": "true returns display values (state names, user names) instead of sys_ids",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "array",
