        "operationId": "listIncidents",
        "summary": "List incidents (Table API)",
        "description": "List incidents (Table API)",
        "parameters": [
          {
            "name": "sysparm_query",
            "in": "query",
            "required": false,
            "description": "Encoded query, e.g. number=INC0000060 or active=true^priority=1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sysparm_limit",
            "in": "query",
            "required": false,
            "description": "Maximum records",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sysparm_fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated fields to return",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sysparm_display_value",
            "in": "query",
            "required": false,
            "description": "true returns display values (state names, user names) instead of sys_ids",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "error"
          }
        },
        "security": [
          {
            "BasicAuth": []
          }
        ]
