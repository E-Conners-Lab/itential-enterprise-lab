{
  "name": "Verify AWS VPN",
  "type": "automation",
  "description": "Verifies the lab's site-to-site VPN to AWS without changing anything: the router (IKEv2 SA, IPsec counters rising), the AWS monitor (where it applies) and a ping from Loopback0 through the tunnel must all say up (PID S13 criterion 4, ADR 0068)",
  "tasks": {
    "1a": {
      "name": "setObjectKey",
      "canvasName": "setObjectKey",
      "summary": "the target and the pinned values",
      "description": "the target and the pinned values",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": 150,
        "y": 600
      },
      "variables": {
        "incoming": {
          "obj": {
            "targets": {
              "clab-rtr1": {
                "target": {
                  "name": "clab-rtr1",
                  "fvrf": "INET",
                  "tunnel_source": "GigabitEthernet4",
                  "front_door_ip": "198.51.100.2",
                  "loopback_ip": "10.100.3.201",
                  "router_inner": "169.254.10.1/30",
                  "aws_inner": "169.254.10.2/30",
                  "vpc_cidr": "10.0.0.0/16",
                  "vpc_private_prefixes": [
                    "10.0.64.0/20",
                    "10.0.80.0/20"
                  ],
                  "lab_prefixes": [
                    "10.100.3.0/24"
                  ],
                  "local_id": "lab-edge.lab.internal",
                  "remote_id": "aws-vpn.lab.internal",
                  "peer_rule": "pinned",
                  "peer_pinned": "198.51.100.20",
                  "bgp_asn": 65010,
                  "inside_interfaces": [
                    "GigabitEthernet2",
                    "GigabitEthernet3"
                  ],
                  "unzoned_interfaces": [
                    "GigabitEthernet1",
                    "GigabitEthernet4"
                  ],
                  "mgmt_host": "10.100.2.11"
                },
                "outputs": {
                  "strongswan_eip": "198.51.100.20",
                  "strongswan_private_ip": "10.0.1.10",
                  "tunnel_local_inner": "169.254.10.2/30",
                  "tunnel_remote_inner": "169.254.10.1/30",
                  "vpc_private_prefixes": [
                    "10.0.64.0/20",
                    "10.0.80.0/20"
                  ]
                },
                "username": "automation",
                "monitor": "none"
              }
            }
          },
          "path": [
            "target"
          ],
          "value": "$var.job.target"
        },
        "outgoing": {
          "object": "$var.job.verify_in"
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "1b": {
      "name": "runCode",
      "canvasName": "runCode",
      "summary": "what to read for this target",
      "description": "what to read for this target",
      "location": "Application",
      "locationType": null,
      "app": "GatewayManager",
      "type": "automatic",
      "displayName": "GatewayManager",
      "groups": [],
      "nodeLocation": {
        "x": -150,
        "y": 750
      },
      "variables": {
        "incoming": {
          "clusterId": "lab",
          "language": "python",
          "code": "import json, sys\nd = json.loads(sys.stdin.read() or \"{}\")\nname = d.get(\"target\")\nentry = (d.get(\"targets\") or {}).get(name) or {}\nmonitor = entry.get(\"monitor\")\ndeployed = entry.get(\"outputs\") if monitor != \"aws\" else d.get(\"deployed\")\nplan = {\"target\": name, \"monitor\": monitor, \"need_outputs\": bool(entry) and monitor == \"aws\" and deployed is None,\n        \"ready\": False, \"reason\": \"\", \"lab_edge\": None, \"monitor_params\": None, \"precheck\": None, \"render\": None,\n        \"push\": None, \"monitor_ready\": None}\nif not entry:\n    plan[\"reason\"] = \"%s is not an open target\" % name\nelif not plan[\"need_outputs\"] and not (deployed or {}).get(\"strongswan_eip\"):\n    plan[\"reason\"] = \"nothing is deployed (the outputs have no strongSwan address)\"\nif entry and deployed and not plan[\"reason\"]:\n    target, outputs, user = json.dumps(entry[\"target\"]), json.dumps(deployed), entry[\"username\"]\n    plan.update(\n        ready=True,\n        lab_edge={\"action\": \"verify\", \"target_json\": target, \"outputs_json\": outputs, \"username\": user, \"timeout\": \"300\"},\n        precheck={\"action\": \"precheck\", \"target_json\": target, \"username\": user, \"timeout\": \"300\"},\n        render={\"action\": \"render\", \"target_json\": target, \"outputs_json\": outputs, \"timeout\": \"300\"},\n        push={\"action\": \"push\", \"target_json\": target, \"outputs_json\": outputs, \"username\": user, \"timeout\": \"600\"})\n    if monitor == \"aws\":\n        instance = str(deployed.get(\"strongswan_instance_id\") or \"\")\n        plan[\"monitor_params\"] = {\"action\": \"check\", \"instance_id\": instance, \"timeout\": \"240\"}\n        plan[\"monitor_ready\"] = {\"action\": \"ready\", \"instance_id\": instance, \"timeout\": \"120\"}\nprint(json.dumps(plan))\n",
          "data": "$var.job.verify_in",
          "safety": {
            "timeout": 30
          },
          "packages": []
        },
        "outgoing": {
          "result": "$var.job.verify_plan"
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
