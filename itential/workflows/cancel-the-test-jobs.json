{
  "name": "Cancel the Test Jobs",
  "type": "automation",
  "description": "Cancels the open jobs of the three test workflows and nothing else; the skills workbench's harness runs it after each run (ADR 0084 amendment)",
  "tasks": {
    "1a": {
      "name": "getJobs",
      "canvasName": "getJobs",
      "summary": "the open jobs of the three test workflows",
      "description": "the open test jobs: read, then picked again by name and status, so nothing else is ever canceled",
      "location": "Application",
      "locationType": null,
      "app": "OperationsManager",
      "type": "automatic",
      "displayName": "OperationsManager",
      "groups": [],
      "nodeLocation": {
        "x": 0,
        "y": 150
      },
      "variables": {
        "incoming": {
          "queryParameters": {
            "in": {
              "name": "Complete a Test Job,Fail a Test Job,Hold a Test Job for Approval",
              "status": "running,error,paused"
            },
            "limit": 200,
            "include": "_id,name,status"
          }
        },
        "outgoing": {
          "result": null
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "1b": {
      "name": "runCode",
      "canvasName": "runCode",
      "summary": "only the test workflows' open jobs (Python on the runner)",
      "description": "the open test jobs: read, then picked again by name and status, so nothing else is ever canceled",
      "location": "Application",
      "locationType": null,
      "app": "GatewayManager",
      "type": "automatic",
      "displayName": "GatewayManager",
      "groups": [],
      "nodeLocation": {
        "x": 50,
        "y": 300
      },
      "variables": {
        "incoming": {
          "clusterId": "lab",
          "language": "python",
          "code": "import json, sys\n\n\ndef open_test_jobs(d: dict) -> dict:\n    \"\"\"The jobs \"Cancel the Test Jobs\" cancels: of getJobs' answer (`data`), only those of the three test workflows\n    (`names`) that are still open (`statuses`), however the query was filtered. `ok` is false when the jobs could not\n    be read. Pure: runCode runs this function's own source on the Gateway.\"\"\"\n    rows = d.get(\"data\")\n    if not isinstance(rows, list):\n        return {\"ok\": False, \"any\": False, \"ids\": [], \"done\": \"\", \"none\": \"\"}\n    ids = sorted({str(r[\"_id\"]) for r in rows if isinstance(r, dict) and r.get(\"_id\")\n                  and r.get(\"name\") in d[\"names\"] and r.get(\"status\") in d[\"statuses\"]})\n    return {\"ok\": True, \"any\": bool(ids), \"ids\": ids,\n            \"done\": f\"Canceled {len(ids)} open job(s) of the three test workflows.\",\n            \"none\": \"No open job of the three test workflows: nothing was canceled.\"}\n\n\nprint(json.dumps(open_test_jobs({**json.loads(sys.stdin.read() or \"{}\"), **json.loads('{\"names\": [\"Complete a Test Job\", \"Fail a Test Job\", \"Hold a Test Job for Approval\"], \"statuses\": [\"running\", \"error\", \"paused\"]}')})))\n",
          "data": "$var.1a.result",
          "safety": {
            "timeout": 30
          },
          "packages": []
        },
        "outgoing": {
          "result": null
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
