    "2b": {
      "name": "runCode",
      "canvasName": "runCode",
      "summary": "did it say Rollback Done? (Python on the runner)",
      "description": "the replace: the router's configuration replaced with bootflash:baseline.cfg, its answer checked",
      "location": "Application",
      "locationType": null,
      "app": "GatewayManager",
      "type": "automatic",
      "displayName": "GatewayManager",
      "groups": [],
      "nodeLocation": {
        "x": 200,
        "y": 1350
