    "3b": {
      "name": "runCode",
      "canvasName": "runCode",
      "summary": "normalised, hashed and compared (Python on the runner)",
      "description": "the proof: the baseline file and the running configuration read back, compared as hashes only",
      "location": "Application",
      "locationType": null,
      "app": "GatewayManager",
      "type": "automatic",
      "displayName": "GatewayManager",
      "groups": [],
      "nodeLocation": {
        "x": 1360,
        "y": 1950
      },
      "variables": {
        "incoming": {
          "clusterId": "lab",
          "language": "python",
          "code": "import json, sys\n\n\nimport hashlib\nimport re\n\nVOLATILE = ('^Building configuration', '^Current configuration :', '^! Last configuration change', '^! NVRAM config last updated')\n\n\ndef restore_proof(d: dict, volatile: tuple) -> dict:\n    \"\"\"The baseline file and the running configuration, each without blank lines and the lines that change by\n    themselves (the header, the change and save stamps), hashed and compared. Only the two hashes and the counts of\n    differing lines leave the runner, never the configuration. Pure: runCode runs this function's own source.\"\"\"\n    results = (d.get(\"result\") or {}).get(\"results\") or []\n    if len(results) != 2 or not all(r.get(\"success\") for r in results):\n        return {\"restored\": False, \"baseline_sha256\": \"\", \"running_sha256\": \"\",\n                \"error\": \"the Gateway could not read the baseline file and the running configuration\"}\n    skip = [re.compile(v) for v in volatile]\n    kept = [[ln.rstrip() for ln in str(r.get(\"output\") or \"\").splitlines()\n             if ln.strip() and not any(s.match(ln.strip()) for s in skip)] for r in results]\n    baseline, running = kept\n    digests = [hashlib.sha256(\"\\n\".join(k).encode()).hexdigest() for k in kept]\n    out = {\"restored\": bool(baseline) and digests[0] == digests[1], \"baseline_sha256\": digests[0],\n           \"running_sha256\": digests[1], \"error\": \"\"}\n    if not baseline:\n        out[\"error\"] = \"bootflash:baseline.cfg is empty or could not be read: capture it again (make skills-lab-devices)\"\n    elif not out[\"restored\"]:\n        out[\"error\"] = (f\"the running configuration differs from bootflash:baseline.cfg after the replace: \"\n                        f\"{len(set(running) - set(baseline))} line(s) only in the running configuration, \"\n                        f\"{len(set(baseline) - set(running))} only in the baseline\")\n    return out\n\n\nprint(json.dumps(restore_proof(json.loads(sys.stdin.read() or \"{}\"), VOLATILE)))\n",
          "data": "$var.3a.result",
          "safety": {
            "timeout": 30
          },
          "packages": []
        },
        "outgoing": {
          "result": "$var.job.restore_proof"
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
