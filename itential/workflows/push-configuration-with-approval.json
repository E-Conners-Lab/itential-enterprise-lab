    "3e": {
      "name": "runCode",
      "canvasName": "runCode",
      "summary": "did the device refuse a line? (Python on the runner)",
      "description": "did the device refuse a line? (Python on the runner)",
      "location": "Application",
      "locationType": null,
      "app": "GatewayManager",
      "type": "automatic",
      "displayName": "GatewayManager",
      "groups": [],
      "nodeLocation": {
        "x": -70,
        "y": 2100
      },
      "variables": {
        "incoming": {
          "clusterId": "lab",
          "language": "python",
          "code": "import json, re, sys\nd = json.loads(sys.stdin.read() or \"{}\")\nlines = str(d.get(\"output\") or \"\").splitlines()\nrefusal = re.compile(r\"^% ?(Invalid|Incomplete|Ambiguous|Unknown|Unrecognized|Bad|Error)\", re.I)\nrejections = []\nfor i, ln in enumerate(lines):\n    if refusal.match(ln.strip()):\n        cmd = next((l.split(\"#\", 1)[1].strip() for l in reversed(lines[:i]) if \"(config\" in l and \"#\" in l), \"\")\n        rejections.append({\"command\": cmd, \"error\": ln.strip()})\nmsg = \"\"\nif rejections:\n    msg = (\"the device rejected %d line(s): \" % len(rejections)\n           + \"; \".join(\"%s (%s)\" % (r[\"command\"], r[\"error\"]) for r in rejections)\n           + \". Lines it accepted before are in the running configuration and were NOT saved\")\nprint(json.dumps({\"rejected\": bool(rejections), \"rejections\": rejections, \"message\": msg}))\n",
          "data": "$var.3d.object",
          "safety": {
            "timeout": 30
          },
          "packages": []
        },
        "outgoing": {
          "result": null
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
