{
  "name": "Run Show Command on a Scratch Device",
  "type": "automation",
  "description": "Runs one show command on one scratch router of the skills eval suite through Gateway 5 and returns its raw output; reads only (ADR 0084)",
  "tasks": {
    "1a": {
      "name": "replace",
      "canvasName": "replace",
      "summary": "commands JSON",
      "description": "the command: the list built from the input, sent to the scratch router through the Gateway; the answer checked",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": -60,
        "y": 1050
      },
      "variables": {
        "incoming": {
          "str": "[\"__C__\"]",
          "substr": "__C__",
          "newSubstr": "$var.job.command"
        },
        "outgoing": {
          "replacedString": null
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "1b": {
      "name": "parse",
      "canvasName": "parse",
      "summary": "commands list",
      "description": "the command: the list built from the input, sent to the scratch router through the Gateway; the answer checked",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": -50,
        "y": 1200
      },
      "variables": {
        "incoming": {
          "text": "$var.1a.replacedString"
        },
        "outgoing": {
          "textObject": null
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "2a": {
      "name": "sendCommand",
      "canvasName": "sendCommand",
      "summary": "run the command through Gateway 5",
      "description": "the command: the list built from the input, sent to the scratch router through the Gateway; the answer checked",
      "location": "Application",
      "locationType": null,
      "app": "GatewayManager",
      "type": "automatic",
      "displayName": "GatewayManager",
      "groups": [],
      "nodeLocation": {
        "x": -40,
        "y": 1350
      },
      "variables": {
        "incoming": {
          "clusterId": "lab",
          "commands": "$var.1b.textObject",
          "inventory": "$var.0b.textObject"
        },
        "outgoing": {
          "result": null
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "2b": {
      "name": "evaluation",
      "canvasName": "evaluation",
      "summary": "did the router answer?",
      "description": "the command: the list built from the input, sent to the scratch router through the Gateway; the answer checked",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "operation",
      "displayName": "WorkFlowEngine",
      "groups": [],
      "nodeLocation": {
        "x": -80,
        "y": 1500
      },
      "variables": {
        "incoming": {
          "all_true_flag": true,
          "evaluation_groups": [
            {
              "all_true_flag": true,
              "evaluations": [
                {
                  "query": "result.results[0].success",
                  "operand_1": {
                    "variable": "result",
                    "task": "2a"
                  },
                  "operator": "==",
                  "operand_2": {
                    "variable": true,
                    "task": "static"
                  }
                }
              ]
            }
          ],
          "options": {}
        },
        "outgoing": {
          "return_value": null
        },
        "error": "",
        "decorators": []
      }
    },
    "3a": {
      "name": "query",
      "canvasName": "query",
      "summary": "the raw output",
      "description": "the answer: the router's output, published as it came (no parser: the scratch routers are not in NetBox)",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "operation",
      "displayName": "WorkFlowEngine",
      "groups": [],
      "nodeLocation": {
        "x": 50,
        "y": 1650
      },
      "variables": {
        "incoming": {
          "pass_on_null": false,
          "query": "result.results[0].output",
          "obj": "$var.2a.result"
        },
        "outgoing": {
          "return_data": "$var.job.raw"
        },
        "error": "",
        "decorators": []
      }
    },
    "5a": {
      "name": "makeData",
      "canvasName": "makeData",
      "summary": "the Gateway could not run it",
      "description": "where it stops: a router the Gateway could not run it on, or one that did not answer, each with its reason",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": 220,
        "y": 1500
      },
      "variables": {
        "incoming": {
          "input": "the command did not run: the Gateway could not reach the router in the skills-lab inventory; report this and do not retry",
          "outputType": "string",
          "variables": ""
        },
        "outgoing": {
          "output": "$var.job.device_error"
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "5b": {
      "name": "makeData",
      "canvasName": "makeData",
      "summary": "the router did not answer",
      "description": "where it stops: a router the Gateway could not run it on, or one that did not answer, each with its reason",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": -180,
        "y": 1800
      },
      "variables": {
        "incoming": {
          "input": "the command did not run on the router (credential or connection error); report this and do not retry",
          "outputType": "string",
          "variables": ""
        },
        "outgoing": {
          "output": "$var.job.device_error"
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "0a": {
      "name": "replace",
      "canvasName": "replace",
      "summary": "selector JSON with the node name",
      "description": "the selector: the one scratch router, in the shape the Gateway wants",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": -90,
        "y": 750
      },
      "variables": {
        "incoming": {
          "str": "[{\"inventory\": \"skills-lab\", \"nodeNames\": [\"__DEVICE__\"]}]",
          "substr": "__DEVICE__",
          "newSubstr": "$var.job.device"
        },
        "outgoing": {
          "replacedString": null
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "0b": {
      "name": "parse",
      "canvasName": "parse",
      "summary": "selector JSON -> object",
      "description": "the selector: the one scratch router, in the shape the Gateway wants",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": -70,
        "y": 900
      },
      "variables": {
        "incoming": {
          "text": "$var.0a.replacedString"
        },
        "outgoing": {
          "textObject": null
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "9a01": {
      "name": "setObjectKey",
      "canvasName": "setObjectKey",
      "summary": "input to check: device",
      "description": "the input gate: every input checked against its schema before anything runs; a refusal ends the job with nothing sent",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": 0,
        "y": 150
      },
      "variables": {
        "incoming": {
          "obj": {},
          "path": [
            "device"
          ],
          "value": "$var.job.device"
        },
        "outgoing": {
          "object": null
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "9a02": {
      "name": "setObjectKey",
      "canvasName": "setObjectKey",
      "summary": "input to check: command",
      "description": "the input gate: every input checked against its schema before anything runs; a refusal ends the job with nothing sent",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": 0,
        "y": 300
      },
      "variables": {
        "incoming": {
          "obj": "$var.9a01.object",
          "path": [
            "command"
          ],
          "value": "$var.job.command"
        },
        "outgoing": {
          "object": null
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "9a0a": {
      "name": "validateJsonSchema",
      "canvasName": "validateJsonSchema",
      "summary": "check the inputs",
      "description": "the input gate: every input checked against its schema before anything runs; a refusal ends the job with nothing sent",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "WorkFlowEngine",
      "groups": [],
      "nodeLocation": {
        "x": 0,
        "y": 450
      },
      "variables": {
        "incoming": {
          "jsonData": "$var.9a02.object",
          "schema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "device",
              "command"
            ],
            "properties": {
              "device": {
                "type": "string",
                "enum": [
                  "skl-r1",
                  "skl-r2",
                  "skl-r3"
                ]
              },
              "command": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^(?!.*://)show [A-Za-z0-9][A-Za-z0-9 ._/:,-]{0,120}( \\| (include|exclude|begin|section|count|json)( [A-Za-z0-9 ._/:,^$*-]{1,80})?)?$"
              }
            }
          }
        },
        "outgoing": {
          "result": "$var.job.input_check"
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "9a0b": {
      "name": "evaluation",
      "canvasName": "evaluation",
      "summary": "inputs valid?",
      "description": "the input gate: every input checked against its schema before anything runs; a refusal ends the job with nothing sent",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "operation",
      "displayName": "WorkFlowEngine",
      "groups": [],
      "nodeLocation": {
        "x": -100,
        "y": 600
      },
      "variables": {
        "incoming": {
          "all_true_flag": true,
          "evaluation_groups": [
            {
              "all_true_flag": true,
              "evaluations": [
                {
                  "query": "valid",
                  "operand_1": {
                    "variable": "result",
                    "task": "9a0a"
                  },
                  "operator": "==",
                  "operand_2": {
                    "variable": true,
                    "task": "static"
                  }
                }
              ]
            }
          ],
          "options": {}
        },
        "outgoing": {
          "return_value": null
        },
        "error": "",
        "decorators": []
      }
    },
    "9a0c": {
      "name": "makeData",
      "canvasName": "makeData",
      "summary": "the inputs were refused",
      "description": "the input gate: every input checked against its schema before anything runs; a refusal ends the job with nothing sent",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": 510,
        "y": 750
      },
      "variables": {
        "incoming": {
          "input": "the inputs were refused before anything ran (see input_check for which input and why): nothing was sent to a device",
          "outputType": "string",
          "variables": ""
        },
        "outgoing": {
          "output": "$var.job.device_error"
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "workflow_start": {
      "name": "workflow_start",
      "summary": "workflow_start",
      "groups": [],
      "nodeLocation": {
        "x": 0,
        "y": 0
      }
    },
    "workflow_end": {
      "name": "workflow_end",
      "summary": "workflow_end",
      "groups": [],
      "nodeLocation": {
        "x": 290,
        "y": 1950
      }
    }
  },
  "transitions": {
    "workflow_start": {
      "9a01": {
        "state": "success",
        "type": "standard"
      }
    },
    "0a": {
      "0b": {
        "state": "success",
        "type": "standard"
      }
    },
    "0b": {
      "1a": {
        "state": "success",
        "type": "standard"
      }
    },
    "1a": {
      "1b": {
        "state": "success",
        "type": "standard"
      }
    },
    "1b": {
      "2a": {
        "state": "success",
        "type": "standard"
      }
    },
    "2a": {
      "2b": {
        "state": "success",
        "type": "standard"
      },
      "5a": {
        "state": "error",
        "type": "standard"
      }
    },
    "2b": {
      "3a": {
        "state": "success",
        "type": "standard"
      },
      "5b": {
        "state": "failure",
        "type": "standard"
      }
    },
    "3a": {
      "workflow_end": {
        "state": "success",
        "type": "standard"
      },
      "5b": {
        "state": "error",
        "type": "standard"
      }
    },
    "5a": {
      "workflow_end": {
        "state": "success",
        "type": "standard"
      }
    },
    "5b": {
      "workflow_end": {
        "state": "success",
        "type": "standard"
      }
    },
    "9a01": {
      "9a02": {
        "state": "success",
        "type": "standard"
      }
    },
    "9a02": {
      "9a0a": {
        "state": "success",
        "type": "standard"
      }
    },
    "9a0a": {
      "9a0b": {
        "state": "success",
        "type": "standard"
      },
      "9a0c": {
        "state": "error",
        "type": "standard"
      }
    },
    "9a0b": {
      "0a": {
        "state": "success",
        "type": "standard"
      },
      "9a0c": {
        "state": "failure",
        "type": "standard"
      }
    },
    "9a0c": {
      "workflow_end": {
        "state": "success",
        "type": "standard"
      }
    },
    "workflow_end": {}
  },
  "groups": [],
  "canvasVersion": 3,
  "inputSchema": {
    "type": "object",
    "properties": {
      "device": {
        "type": "string",
        "required": true,
        "enum": [
          "skl-r1",
          "skl-r2",
          "skl-r3"
        ],
        "description": "The scratch router (skills_lab.nodes), e.g. skl-r1"
      },
      "command": {
        "type": "string",
        "required": true,
        "description": "One show command, e.g. show ip ospf neighbor"
      }
    },
    "required": [
      "device",
      "command"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "raw": {
        "type": "string"
      },
      "device_error": {
        "type": "string"
      },
      "input_check": {
        "type": "object"
      }
    }
  },
  "tags": [],
  "preAutomationTime": 300000,
  "sla": 600000,
  "font_size": 12,
  "decorators": []
}
