{
  "name": "Check AWS Drift",
  "type": "automation",
  "description": "Reports what changed in AWS outside Terraform without changing anything: a refresh-only plan reads every resource and names the ones that drifted and their attributes; drift opens a Work Center task (R3, ADR 0068)",
  "tasks": {
    "1a": {
      "name": "parse",
      "canvasName": "parse",
      "summary": "terraform-run drift's params",
      "description": "terraform-run drift's params",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": 0,
        "y": 150
      },
      "variables": {
        "incoming": {
          "text": "{\"action\": \"drift\", \"timeout\": \"600\"}"
        },
        "outgoing": {
          "textObject": null
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "1b": {
      "name": "runService",
      "canvasName": "runService",
      "summary": "what changed in AWS outside Terraform (terraform-run drift, a refresh-only plan)",
      "description": "what changed in AWS outside Terraform (terraform-run drift, a refresh-only plan)",
      "location": "Application",
      "locationType": null,
      "app": "GatewayManager",
      "type": "automatic",
      "displayName": "GatewayManager",
      "groups": [],
      "nodeLocation": {
        "x": 0,
        "y": 300
      },
      "variables": {
        "incoming": {
          "serviceName": "terraform-run",
          "clusterId": "lab",
          "params": "$var.1a.textObject"
        },
        "outgoing": {
          "result": "$var.job.drift_result"
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "1c": {
      "name": "evaluation",
      "canvasName": "evaluation",
      "summary": "the drift check answered?",
      "description": "the drift check answered?",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "operation",
      "displayName": "WorkFlowEngine",
      "groups": [],
      "nodeLocation": {
        "x": 100,
        "y": 450
      },
      "variables": {
        "incoming": {
          "all_true_flag": true,
          "evaluation_groups": [
            {
              "all_true_flag": true,
              "evaluations": [
                {
                  "query": "result.return_code",
                  "operand_1": {
                    "variable": "result",
                    "task": "1b"
                  },
                  "operator": "==",
                  "operand_2": {
                    "variable": 0,
                    "task": "static"
                  }
                }
              ]
            }
          ],
          "options": {}
        },
        "outgoing": {
          "return_value": null
        },
        "error": "",
        "decorators": []
      }
    },
    "1d": {
      "name": "setObjectKey",
      "canvasName": "setObjectKey",
      "summary": "the drift check's answer",
      "description": "the drift check's answer",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": 100,
        "y": 600
      },
      "variables": {
        "incoming": {
          "obj": {},
          "path": [
            "drift"
          ],
          "value": "$var.job.drift_result"
        },
        "outgoing": {
          "object": null
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "1e": {
      "name": "runCode",
      "canvasName": "runCode",
      "summary": "what was found (Python on the runner)",
      "description": "what was found (Python on the runner)",
      "location": "Application",
      "locationType": null,
      "app": "GatewayManager",
      "type": "automatic",
      "displayName": "GatewayManager",
      "groups": [],
      "nodeLocation": {
        "x": 100,
        "y": 750
      },
      "variables": {
        "incoming": {
          "clusterId": "lab",
          "language": "python",
          "code": "import json, sys\n\n\ndef drift_summary(d: dict) -> dict:\n    \"\"\"What the drift check found, in words. `d` holds terraform-run drift's answer under `drift`. Pure: runCode runs\n    this source on the Gateway.\"\"\"\n    result = (d.get(\"drift\") or {}).get(\"result\") or {}\n    rep = (result.get(\"stdout_json\") or {}).get(\"drift\")\n    if result.get(\"return_code\") != 0 or not isinstance(rep, dict):\n        return {\"ok\": False, \"found\": False, \"summary\": \"The drift check could not run (see drift_result): nothing \"\n                                                        \"was changed.\"}\n    checked, resources = rep.get(\"resources_checked\", 0), rep.get(\"resources\") or []\n    if not checked:\n        return {\"ok\": True, \"found\": False, \"drifted\": 0, \"summary\": \"nothing is deployed in AWS: nothing to check\"}\n    if not resources:\n        return {\"ok\": True, \"found\": False, \"drifted\": 0,\n                \"summary\": f\"no drift: {checked} resources in AWS match the Terraform state\"}\n    named = [r.get(\"address\", \"?\") + (\" (deleted outside Terraform)\" if \"delete\" in (r.get(\"actions\") or [])\n                                      else \" (\" + \", \".join(r.get(\"attributes\") or [\"changed\"]) + \")\")\n             for r in resources]\n    return {\"ok\": True, \"found\": True, \"drifted\": len(resources), \"resources\": resources,\n            \"summary\": f\"Drift in AWS: {len(resources)} of {checked} resources changed outside Terraform: \"\n                       + \"; \".join(named) + \". Nothing was changed by this check. Two ways back: Deploy AWS VPN with \"\n                       \"the same inputs puts AWS back to what Terraform wants, or Tear Down AWS VPN removes it all.\"}\n\n\nprint(json.dumps(drift_summary(json.loads(sys.stdin.read() or \"{}\"))))\n",
          "data": "$var.1d.object",
          "safety": {
            "timeout": 30
          },
          "packages": []
        },
        "outgoing": {
          "result": "$var.job.drift"
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "1f": {
      "name": "evaluation",
      "canvasName": "evaluation",
      "summary": "drift found?",
      "description": "drift found?",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "operation",
      "displayName": "WorkFlowEngine",
      "groups": [],
      "nodeLocation": {
        "x": 250,
        "y": 900
      },
      "variables": {
        "incoming": {
          "all_true_flag": true,
          "evaluation_groups": [
            {
              "all_true_flag": true,
              "evaluations": [
                {
                  "query": "stdout_json.found",
                  "operand_1": {
                    "variable": "result",
                    "task": "1e"
                  },
                  "operator": "==",
                  "operand_2": {
                    "variable": true,
                    "task": "static"
                  }
                }
              ]
            }
          ],
          "options": {}
        },
        "outgoing": {
          "return_value": null
        },
        "error": "",
        "decorators": []
      }
    },
