    "4a": {
      "name": "runCode",
      "canvasName": "runCode",
      "summary": "parse per device on the runner (Genie / TextFSM)",
      "description": "parse per device on the runner (Genie / TextFSM)",
      "location": "Application",
      "locationType": null,
      "app": "GatewayManager",
      "type": "automatic",
      "displayName": "GatewayManager",
      "groups": [],
      "nodeLocation": {
        "x": 0,
        "y": 1260
      },
      "variables": {
        "incoming": {
          "clusterId": "lab",
          "language": "python",
          "code": "import json, sys\nGENIE = {\"cisco_ios\": \"iosxe\"}  # the lab's cisco_ios nodes are IOS-XE (C8000v)\nTEXTFSM = {\"arista_eos\": \"arista_eos\"}\nLIMIT = 1500\nd = json.loads(sys.stdin.read() or \"{}\")\nostype = {x.get(\"name\"): x.get(\"ostype\") for x in (d.get(\"devices\") or {}).get(\"list\") or []}\nout = {\"devices\": [], \"results\": {}, \"parser_errors\": {}}\nfor r in ((d.get(\"result\") or {}).get(\"results\") or []):\n    name, output, command = r.get(\"name\"), r.get(\"output\") or \"\", r.get(\"command\") or \"\"\n    os_ = ostype.get(name)\n    entry = {\"ostype\": os_, \"parser\": \"none\", \"parsed\": None, \"truncated\": False}\n    if not r.get(\"success\", True):\n        entry[\"error\"] = \"command failed\"\n        entry[\"raw_head\"] = output[:600]\n    else:\n        try:\n            if os_ in GENIE:\n                from genie.conf.base import Device\n                dev = Device(name=\"x\", os=GENIE[os_])\n                dev.custom.setdefault(\"abstraction\", {\"order\": [\"os\"]})\n                entry[\"parsed\"], entry[\"parser\"] = dev.parse(command, output=output), \"genie\"\n            elif os_ in TEXTFSM:\n                from ntc_templates.parse import parse_output\n                entry[\"parsed\"], entry[\"parser\"] = parse_output(platform=TEXTFSM[os_], command=command, data=output), \"textfsm\"\n            else:\n                entry[\"error\"] = \"no parser for ostype %s\" % os_\n                entry[\"raw_head\"] = output[:600]\n        except Exception as e:  # unsupported command or empty output: keep the head of the raw text\n            entry[\"error\"] = type(e).__name__ + \": \" + str(e)[:200]\n            entry[\"raw_head\"] = output[:600]\n    text = json.dumps(entry[\"parsed\"]) if entry[\"parsed\"] is not None else \"\"\n    if len(text) > LIMIT:\n        entry[\"parsed\"], entry[\"truncated\"] = text[:LIMIT] + \"...\", True\n    if entry.get(\"error\"):\n        out[\"parser_errors\"][name] = entry[\"error\"]\n    out[\"devices\"].append(name)\n    out[\"results\"][name] = entry\nout[\"devices_checked\"] = len(out[\"devices\"])\nprint(json.dumps(out))\n",
          "data": "$var.3b.object",
          "safety": {
            "timeout": 240
          },
          "packages": [
            "pyats==26.8",
            "genie==26.8",
            "textfsm==2.1.0",
            "ntc-templates==9.2.0"
          ]
        },
        "outgoing": {
          "result": null
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
