{
  "name": "Complete a Test Job",
  "type": "automation",
  "description": "Echoes one message into echo and ends Complete; the skills workbench's job-run tests, no device and no adapter (ADR 0084 amendment)",
  "tasks": {
    "1a": {
      "name": "makeData",
      "canvasName": "makeData",
      "summary": "the message, into echo",
      "description": "the echo: the message, published as it came",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": -150,
        "y": 600
      },
      "variables": {
        "incoming": {
          "input": "$var.job.message",
          "outputType": "string",
          "variables": ""
        },
        "outgoing": {
          "output": "$var.job.echo"
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "5a": {
      "name": "makeData",
      "canvasName": "makeData",
      "summary": "the echo failed",
      "description": "where it stops: an echo that failed, with its reason",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": 300,
        "y": 750
      },
      "variables": {
        "incoming": {
          "input": "the message could not be echoed",
          "outputType": "string",
          "variables": ""
        },
        "outgoing": {
          "output": "$var.job.error"
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "9a01": {
      "name": "setObjectKey",
      "canvasName": "setObjectKey",
      "summary": "input to check: message",
      "description": "the input gate: every input checked against its schema before anything runs; a refusal ends the job with nothing sent",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": 0,
        "y": 150
      },
      "variables": {
        "incoming": {
          "obj": {},
          "path": [
            "message"
          ],
          "value": "$var.job.message"
        },
        "outgoing": {
          "object": null
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "9a0a": {
      "name": "validateJsonSchema",
      "canvasName": "validateJsonSchema",
      "summary": "check the inputs",
      "description": "the input gate: every input checked against its schema before anything runs; a refusal ends the job with nothing sent",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "WorkFlowEngine",
      "groups": [],
      "nodeLocation": {
        "x": 150,
        "y": 300
      },
      "variables": {
        "incoming": {
          "jsonData": "$var.9a01.object",
          "schema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "message"
            ],
            "properties": {
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        },
        "outgoing": {
          "result": "$var.job.input_check"
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "9a0b": {
      "name": "evaluation",
      "canvasName": "evaluation",
      "summary": "inputs valid?",
      "description": "the input gate: every input checked against its schema before anything runs; a refusal ends the job with nothing sent",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "operation",
      "displayName": "WorkFlowEngine",
      "groups": [],
      "nodeLocation": {
        "x": 0,
        "y": 450
      },
      "variables": {
        "incoming": {
          "all_true_flag": true,
          "evaluation_groups": [
            {
              "all_true_flag": true,
              "evaluations": [
                {
                  "query": "valid",
                  "operand_1": {
                    "variable": "result",
                    "task": "9a0a"
                  },
                  "operator": "==",
                  "operand_2": {
                    "variable": true,
                    "task": "static"
                  }
                }
              ]
            }
          ],
          "options": {}
        },
        "outgoing": {
          "return_value": null
        },
        "error": "",
        "decorators": []
      }
    },
    "9a0c": {
      "name": "makeData",
      "canvasName": "makeData",
      "summary": "the inputs were refused",
      "description": "the input gate: every input checked against its schema before anything runs; a refusal ends the job with nothing sent",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": 150,
        "y": 600
      },
      "variables": {
        "incoming": {
          "input": "the inputs were refused before anything ran (see input_check for which input and why): nothing was sent to a device",
          "outputType": "string",
          "variables": ""
        },
        "outgoing": {
          "output": "$var.job.error"
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "workflow_start": {
      "name": "workflow_start",
      "summary": "workflow_start",
      "groups": [],
      "nodeLocation": {
        "x": 0,
        "y": 0
      }
    },
    "workflow_end": {
      "name": "workflow_end",
      "summary": "workflow_end",
      "groups": [],
      "nodeLocation": {
        "x": 0,
        "y": 900
      }
    }
  },
  "transitions": {
    "workflow_start": {
      "9a01": {
        "state": "success",
        "type": "standard"
      }
    },
    "1a": {
      "workflow_end": {
        "state": "success",
        "type": "standard"
      },
      "5a": {
        "state": "error",
        "type": "standard"
      }
    },
    "5a": {
      "workflow_end": {
        "state": "success",
        "type": "standard"
      }
    },
    "9a01": {
      "9a0a": {
        "state": "success",
        "type": "standard"
      }
    },
    "9a0a": {
      "9a0b": {
        "state": "success",
        "type": "standard"
      },
      "9a0c": {
        "state": "error",
        "type": "standard"
      }
    },
    "9a0b": {
      "1a": {
        "state": "success",
        "type": "standard"
      },
      "9a0c": {
        "state": "failure",
        "type": "standard"
      }
    },
    "9a0c": {
      "workflow_end": {
        "state": "success",
        "type": "standard"
      }
    },
    "workflow_end": {}
  },
  "groups": [],
  "canvasVersion": 3,
  "inputSchema": {
    "type": "object",
    "properties": {
      "message": {
        "type": "string",
        "required": true,
        "description": "Any text, e.g. hello"
      }
    },
    "required": [
      "message"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "echo": {
        "type": "string"
      },
      "error": {
        "type": "string"
      },
      "input_check": {
        "type": "object"
      }
    }
  },
  "tags": [],
  "preAutomationTime": 300000,
  "sla": 600000,
  "font_size": 12,
  "decorators": []
}
