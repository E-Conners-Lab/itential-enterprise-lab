    "6b": {
      "name": "runCode",
      "canvasName": "runCode",
      "summary": "summary per device (Python on the runner)",
      "description": "summary per device (Python on the runner)",
      "location": "Application",
      "locationType": null,
      "app": "GatewayManager",
      "type": "automatic",
      "displayName": "GatewayManager",
      "groups": [],
      "nodeLocation": {
        "x": 370,
        "y": 4050
      },
      "variables": {
        "incoming": {
          "clusterId": "lab",
          "language": "python",
          "code": "import json, sys\nd = json.loads(sys.stdin.read() or \"{}\")\nreports = d.get(\"reports\") if isinstance(d, dict) else d\nif isinstance(reports, dict):\n    reports = reports.get(\"complianceHistory\") or reports.get(\"list\") or []\nreports = reports or []\ndevices = []\nfor r in reports:\n    t = r.get(\"totals\") or {}\n    issues = [\" \".join(w.get(\"value\", \"\") for w in (i.get(\"spec\") or {}).get(\"words\", [])).strip() for i in r.get(\"issues\") or []]\n    devices.append({\"device\": r.get(\"deviceName\"), \"report_id\": r.get(\"id\") or r.get(\"_id\"), \"errors\": t.get(\"errors\", 0),\n                    \"warnings\": t.get(\"warnings\", 0), \"passes\": t.get(\"passes\", 0), \"issues\": issues})\ndevices.sort(key=lambda x: str(x[\"device\"]))\nbad = [x[\"device\"] for x in devices if x[\"errors\"] or x[\"warnings\"]]\n# A device with nothing evaluated (no pass, error or warning - its configuration could not be read, e.g. a sealed\n# Vault) was not checked, and no device at all is no answer: neither may ever read as compliant (ADR 0066).\nnot_checked = [x[\"device\"] for x in devices if not (x[\"passes\"] or x[\"errors\"] or x[\"warnings\"])]\nout = {\"compliant\": bool(devices) and not bad and not not_checked, \"devices_checked\": len(devices) - len(not_checked),\n       \"devices_with_issues\": bad, \"devices_not_checked\": not_checked, \"devices\": devices}\nif not devices:\n    out[\"error\"] = \"no device report in this run: compliance could not be evaluated\"\nprint(json.dumps(out))\n",
          "data": "$var.6e.object",
          "safety": {
            "timeout": 30
          },
          "packages": []
        },
        "outgoing": {
          "result": null
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
