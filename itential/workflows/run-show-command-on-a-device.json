    "3c": {
      "name": "replace",
      "canvasName": "replace",
      "summary": "parse code for this platform",
      "description": "parse code for this platform",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": 620,
        "y": 1950
      },
      "variables": {
        "incoming": {
          "str": "import json, sys\nPLATFORM = \"__P__\"  # NetBox platform slug of the node (the workflow replaces it)\nGENIE = {\"ios-xe\": \"iosxe\", \"ios\": \"ios\", \"nx-os\": \"nxos\", \"ios-xr\": \"iosxr\"}\nTEXTFSM = {\"eos\": \"arista_eos\", \"junos\": \"juniper_junos\"}\nd = json.loads(sys.stdin.read() or \"{}\")\nr = ((d.get(\"result\") or {}).get(\"results\") or [{}])[0]\ncommand, output = r.get(\"command\", \"\"), r.get(\"output\", \"\")\nout = {\"parser\": \"none\", \"platform\": PLATFORM, \"command\": command, \"device\": r.get(\"name\"), \"parsed\": None, \"error\": \"\"}\ntry:\n    if PLATFORM in GENIE:\n        from genie.conf.base import Device\n        dev = Device(name=\"x\", os=GENIE[PLATFORM])\n        dev.custom.setdefault(\"abstraction\", {\"order\": [\"os\"]})\n        out[\"parsed\"], out[\"parser\"] = dev.parse(command, output=output), \"genie\"\n    elif PLATFORM in TEXTFSM:\n        from ntc_templates.parse import parse_output\n        out[\"parsed\"], out[\"parser\"] = parse_output(platform=TEXTFSM[PLATFORM], command=command, data=output), \"textfsm\"\n    else:\n        out[\"error\"] = \"no parser for platform \" + PLATFORM\nexcept Exception as e:  # unsupported command or empty output: report, keep the raw text usable\n    out[\"error\"] = type(e).__name__ + \": \" + str(e)[:300]\nprint(json.dumps(out))\n",
          "substr": "__P__",
          "newSubstr": "$var.3b.return_data"
        },
        "outgoing": {
          "replacedString": null
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
