    "6b": {
      "name": "runCode",
      "canvasName": "runCode",
      "summary": "summary per device (Python on the runner)",
      "description": "summary per device (Python on the runner)",
      "location": "Application",
      "locationType": null,
      "app": "GatewayManager",
      "type": "automatic",
      "displayName": "GatewayManager",
      "groups": [],
      "nodeLocation": {
        "x": 4500,
        "y": 0
      },
      "variables": {
        "incoming": {
          "clusterId": "lab",
          "language": "python",
          "code": "import json, sys\nd = json.loads(sys.stdin.read() or \"{}\")\nreports = d.get(\"reports\") if isinstance(d, dict) else d\nif isinstance(reports, dict):\n    reports = reports.get(\"complianceHistory\") or reports.get(\"list\") or []\nreports = reports or []\ndevices = []\nfor r in reports:\n    t = r.get(\"totals\") or {}\n    issues = [\" \".join(w.get(\"value\", \"\") for w in (i.get(\"spec\") or {}).get(\"words\", [])).strip() for i in r.get(\"issues\") or []]\n    devices.append({\"device\": r.get(\"deviceName\"), \"report_id\": r.get(\"id\") or r.get(\"_id\"), \"errors\": t.get(\"errors\", 0),\n                    \"warnings\": t.get(\"warnings\", 0), \"passes\": t.get(\"passes\", 0), \"issues\": issues})\ndevices.sort(key=lambda x: str(x[\"device\"]))\nbad = [x[\"device\"] for x in devices if x[\"errors\"] or x[\"warnings\"]]\nprint(json.dumps({\"compliant\": not bad, \"devices_checked\": len(devices), \"devices_with_issues\": bad, \"devices\": devices}))\n",
          "data": "$var.6e.object",
          "safety": {
            "timeout": 30
          },
          "packages": []
        },
        "outgoing": {
          "result": null
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
