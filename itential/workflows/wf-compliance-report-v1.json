    "4b": {
      "name": "runCode",
      "canvasName": "runCode",
      "summary": "newest complete instance (Python on the runner)",
      "description": "newest complete instance (Python on the runner)",
      "location": "Application",
      "locationType": null,
      "app": "GatewayManager",
      "type": "automatic",
      "displayName": "GatewayManager",
      "groups": [],
      "nodeLocation": {
        "x": 1200,
        "y": 300
      },
      "variables": {
        "incoming": {
          "clusterId": "lab",
          "language": "python",
          "code": "import json, sys\nd = json.loads(sys.stdin.read() or \"{}\")\nplans = d.get(\"plans\") or [p for g in d.get(\"groups\", []) for p in g.get(\"plans\", [])]\ndone = [p for p in plans if p.get(\"jobStatus\") == \"complete\" and p.get(\"batchId\")]\ndone.sort(key=lambda p: str(p.get(\"started\") or p.get(\"triggeredAt\") or p.get(\"id\") or \"\"))\np = done[-1] if done else {}\nprint(json.dumps({\"batchId\": p.get(\"batchId\"), \"instanceId\": p.get(\"id\") or p.get(\"_id\"), \"startTime\": p.get(\"startTime\")}))\n",
          "data": "$var.4a.compliancePlanInstances",
          "safety": {
            "timeout": 30
          },
          "packages": []
        },
        "outgoing": {
          "result": null
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
