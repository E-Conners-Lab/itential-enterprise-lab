{
  "name": "wf-compliance-report-v1",
  "type": "automation",
  "description": "Runs (run=true) or reads (run=false) the lab-baseline compliance plan and returns one compact summary per device: errors, warnings, passes and the issue lines; the agents' compliance tool (PID S4d.5, ADR 0046)",
  "tasks": {
    "1a": {
      "name": "searchCompliancePlans",
      "canvasName": "searchCompliancePlans",
      "summary": "the plan by name",
      "description": "the plan by name",
      "location": "Application",
      "locationType": null,
      "app": "ConfigurationManager",
      "type": "automatic",
      "displayName": "ConfigurationManager",
      "groups": [],
      "nodeLocation": {
        "x": 0,
        "y": 0
      },
      "variables": {
        "incoming": {
          "name": "^lab-baseline$",
          "options": {
            "start": 0,
            "limit": 10
          }
        },
        "outgoing": {
          "compliancePlans": null
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "1b": {
      "name": "query",
      "canvasName": "query",
      "summary": "plan id",
      "description": "plan id",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "operation",
