      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": 0,
        "y": 150
      },
      "variables": {
        "incoming": {
          "text": "{\"action\": \"plan\", \"job\": \"new\", \"enable_vpn\": \"true\", \"timeout\": \"900\"}"
