{
  "name": "Get Device Software Version",
  "type": "automation",
  "description": "Runs 'show version' on one inventory node through Gateway 5 and returns the raw output (PID S4.3)",
  "tasks": {
    "1a": {
      "name": "sendCommand",
      "canvasName": "sendCommand",
      "summary": "show version through Gateway 5",
      "description": "show version through Gateway 5",
      "location": "Application",
      "locationType": null,
      "app": "GatewayManager",
      "type": "automatic",
      "displayName": "GatewayManager",
      "groups": [],
      "nodeLocation": {
        "x": -80,
        "y": 900
      },
      "variables": {
        "incoming": {
          "clusterId": "lab",
          "commands": [
            "show version"
          ],
          "inventory": "$var.0b.textObject"
        },
        "outgoing": {
          "result": "$var.job.show_version"
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "0a": {
      "name": "replace",
      "canvasName": "replace",
      "summary": "selector JSON with the node name",
      "description": "selector JSON with the node name",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": -100,
        "y": 600
      },
      "variables": {
        "incoming": {
          "str": "[{\"inventory\": \"lab\", \"nodeNames\": [\"__DEVICE__\"]}]",
          "substr": "__DEVICE__",
          "newSubstr": "$var.job.device"
        },
        "outgoing": {
          "replacedString": null
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "0b": {
      "name": "parse",
      "canvasName": "parse",
      "summary": "selector JSON -> object",
      "description": "selector JSON -> object",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": -90,
        "y": 750
      },
      "variables": {
        "incoming": {
          "text": "$var.0a.replacedString"
        },
        "outgoing": {
          "textObject": null
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "2a": {
      "name": "evaluation",
      "canvasName": "evaluation",
      "summary": "did the device answer?",
      "description": "did the device answer?",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "operation",
      "displayName": "WorkFlowEngine",
      "groups": [],
      "nodeLocation": {
        "x": 40,
        "y": 1050
      },
      "variables": {
        "incoming": {
          "all_true_flag": true,
          "evaluation_groups": [
            {
              "all_true_flag": true,
              "evaluations": [
                {
                  "query": "result.results[0].success",
                  "operand_1": {
                    "variable": "result",
                    "task": "1a"
                  },
                  "operator": "==",
                  "operand_2": {
                    "variable": true,
                    "task": "static"
                  }
                }
              ]
            }
          ],
          "options": {}
        },
        "outgoing": {
          "return_value": null
        },
        "error": "",
        "decorators": []
      }
    },
    "2b": {
      "name": "makeData",
      "canvasName": "makeData",
      "summary": "the device did not answer",
      "description": "the device did not answer",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": -180,
        "y": 1200
      },
      "variables": {
        "incoming": {
          "input": "the command did not run on the device (credential or connection error); report this and do not retry",
          "outputType": "string",
          "variables": ""
        },
        "outgoing": {
          "output": "$var.job.device_error"
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "9a01": {
      "name": "setObjectKey",
      "canvasName": "setObjectKey",
      "summary": "input to check: device",
      "description": "input to check: device",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": 0,
        "y": 150
      },
      "variables": {
        "incoming": {
          "obj": {},
          "path": [
            "device"
          ],
          "value": "$var.job.device"
        },
        "outgoing": {
          "object": null
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "9a0a": {
      "name": "validateJsonSchema",
      "canvasName": "validateJsonSchema",
      "summary": "check the inputs",
      "description": "check the inputs",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "WorkFlowEngine",
      "groups": [],
      "nodeLocation": {
        "x": 0,
        "y": 300
      },
      "variables": {
        "incoming": {
          "jsonData": "$var.9a01.object",
          "schema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "device"
            ],
            "properties": {
              "device": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
              }
            }
          }
        },
        "outgoing": {
          "result": "$var.job.input_check"
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "9a0b": {
      "name": "evaluation",
      "canvasName": "evaluation",
      "summary": "inputs valid?",
      "description": "inputs valid?",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "operation",
      "displayName": "WorkFlowEngine",
      "groups": [],
      "nodeLocation": {
        "x": -100,
        "y": 450
      },
      "variables": {
        "incoming": {
          "all_true_flag": true,
          "evaluation_groups": [
            {
              "all_true_flag": true,
              "evaluations": [
                {
                  "query": "valid",
                  "operand_1": {
                    "variable": "result",
                    "task": "9a0a"
                  },
                  "operator": "==",
                  "operand_2": {
                    "variable": true,
                    "task": "static"
                  }
                }
              ]
            }
          ],
          "options": {}
        },
        "outgoing": {
          "return_value": null
        },
        "error": "",
        "decorators": []
      }
    },
    "9a0c": {
      "name": "makeData",
      "canvasName": "makeData",
      "summary": "the inputs were refused",
      "description": "the inputs were refused",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": 200,
        "y": 600
      },
      "variables": {
        "incoming": {
          "input": "the inputs were refused before anything ran (see input_check for which input and why): nothing was sent to a device",
          "outputType": "string",
          "variables": ""
        },
        "outgoing": {
          "output": "$var.job.device_error"
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "workflow_start": {
      "name": "workflow_start",
      "summary": "workflow_start",
      "groups": [],
      "nodeLocation": {
        "x": 0,
        "y": 0
      }
    },
    "workflow_end": {
      "name": "workflow_end",
      "summary": "workflow_end",
      "groups": [],
      "nodeLocation": {
        "x": 120,
        "y": 1350
      }
    }
  },
  "transitions": {
    "workflow_start": {
      "9a01": {
        "state": "success",
        "type": "standard"
      }
    },
    "0a": {
      "0b": {
        "state": "success",
        "type": "standard"
      }
    },
    "0b": {
      "1a": {
        "state": "success",
        "type": "standard"
      }
    },
    "1a": {
      "2a": {
        "state": "success",
        "type": "standard"
      },
      "2b": {
        "state": "error",
        "type": "standard"
      }
    },
    "2a": {
      "workflow_end": {
        "state": "success",
        "type": "standard"
      },
      "2b": {
        "state": "failure",
        "type": "standard"
      }
    },
    "2b": {
      "workflow_end": {
        "state": "success",
        "type": "standard"
      }
    },
    "9a01": {
      "9a0a": {
        "state": "success",
        "type": "standard"
      }
    },
    "9a0a": {
      "9a0b": {
        "state": "success",
        "type": "standard"
      },
      "9a0c": {
        "state": "error",
        "type": "standard"
      }
    },
    "9a0b": {
      "0a": {
        "state": "success",
        "type": "standard"
      },
      "9a0c": {
        "state": "failure",
        "type": "standard"
      }
    },
    "9a0c": {
      "workflow_end": {
        "state": "success",
        "type": "standard"
      }
    },
    "workflow_end": {}
  },
  "groups": [],
  "canvasVersion": 3,
  "inputSchema": {
    "type": "object",
    "properties": {
      "device": {
        "type": "string",
        "required": true,
        "description": "Inventory node name, e.g. br1-sw01"
      }
    },
    "required": [
      "device"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "show_version": {
        "type": "object"
      },
      "device_error": {
        "type": "string"
      },
      "input_check": {
        "type": "object"
      }
    }
  },
  "tags": [],
  "preAutomationTime": 300000,
  "sla": 600000,
  "font_size": 12,
  "decorators": []
}
