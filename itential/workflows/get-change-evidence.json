{
  "name": "Get Change Evidence",
  "type": "automation",
  "description": "Collects what a change-risk review needs, reading only: the change request by its number, the other open changes, the open incidents and the lab's devices, published as one `evidence` object; change-risk-reviewer's tool (ADR 0087)",
  "tasks": {
    "1a": {
      "name": "replace",
      "canvasName": "replace",
      "summary": "the change request's query",
      "description": "the change: its number looked up in ServiceNow, the record reduced to its fields",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "automatic",
      "displayName": "Tools",
      "groups": [],
      "nodeLocation": {
        "x": -100,
        "y": 600
      },
      "variables": {
        "incoming": {
          "str": "number=__N__",
          "substr": "__N__",
          "newSubstr": "$var.job.change"
        },
        "outgoing": {
          "replacedString": null
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "1b": {
