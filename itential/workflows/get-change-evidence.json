      "variables": {
        "incoming": {
          "adapter_id": "servicenow-api",
          "sysparm_query": "$var.1a.replacedString",
          "sysparm_fields": "number,short_description,description,type,state,risk,impact,priority,start_date,end_date,cmdb_ci,assignment_group,justification,implementation_plan,backout_plan,test_plan",
