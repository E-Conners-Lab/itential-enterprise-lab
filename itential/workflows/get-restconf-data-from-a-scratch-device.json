{
  "name": "Get RESTCONF Data from a Scratch Device",
  "type": "automation",
  "description": "Reads one allowlisted RESTCONF path from one scratch router of the skills eval suite through the Gateway's restconf-get service, trusted only through the router's certificate pin, and returns the data as JSON; reads only (ADR 0084)",
  "tasks": {
