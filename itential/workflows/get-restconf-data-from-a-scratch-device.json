      "actor": "Pronghorn",
      "scheduled": false
    },
    "1c": {
      "name": "runCode",
      "canvasName": "runCode",
      "summary": "restconf-get's params from the router's pin (Python on the runner)",
      "description": "the read's inputs: the router's pinned target from skills_lab.nodes, the path and the reader account",
      "location": "Application",
      "locationType": null,
      "app": "GatewayManager",
      "type": "automatic",
      "displayName": "GatewayManager",
      "groups": [],
      "nodeLocation": {
        "x": -80,
        "y": 1050
      },
      "variables": {
        "incoming": {
          "clusterId": "lab",
          "language": "python",
          "code": "import json, sys\n\n\nNODES = {'skl-r1': {'mgmt_host': '10.100.0.152', 'cert_sha256': 'c3c1c8dc11d12242ba496b3e6ac4d9e0371ac466861e9d2189499f1372e1b94f'}, 'skl-r2': {'mgmt_host': '10.100.0.153', 'cert_sha256': '2a4ecc0b9f14c01146c4a0ba399ed089a91490eb610229319f65c26ae6dbd1bb'}, 'skl-r3': {'mgmt_host': '10.100.0.154', 'cert_sha256': 'f082ba3a1c65f6cff22a00567fa1ef42acf0a48d00ebf9b0e9ba858e94f57a53'}}\nUSER = 'restconf-reader'\nTIMEOUT = '60'\n\n\ndef restconf_params(d: dict, nodes: dict, user: str, timeout: str) -> dict:\n    \"\"\"restconf-get's params for one scratch router: its pinned target exactly as skills_lab.nodes holds it, the path\n    and the reader (the service checks every one of them again). Pure: runCode runs this function's own source.\"\"\"\n    name = d.get(\"device\")\n    node = nodes[name]  # the input gate allows only these names; anything else is an error, not a guess\n    target = {\"name\": name, \"mgmt_host\": node[\"mgmt_host\"], \"cert_sha256\": node[\"cert_sha256\"]}\n    return {\"params\": {\"target_json\": json.dumps(target), \"path\": d.get(\"path\"), \"username\": user,\n                       \"timeout\": timeout}}\n\n\nprint(json.dumps(restconf_params(json.loads(sys.stdin.read() or \"{}\"), NODES, USER, TIMEOUT)))\n",
          "data": "$var.1b.object",
          "safety": {
            "timeout": 30
          },
          "packages": []
        },
        "outgoing": {
          "result": "$var.job.restconf_params"
        },
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "scheduled": false
    },
    "1d": {
      "name": "query",
      "canvasName": "query",
      "summary": "the params",
      "description": "the read's inputs: the router's pinned target from skills_lab.nodes, the path and the reader account",
      "location": "Application",
