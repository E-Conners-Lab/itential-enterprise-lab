  "schema": {
    "title": "lab-deploy-aws-vpn",
    "description": "Deploy the AWS side of the lab's site-to-site VPN: Terraform plans it, a Work Center approval shows the plan (PID S13, ADR 0068)",
    "type": "object",
    "required": [
      "onprem_public_ip",
      "enable_nat_gateway",
      "change_note",
      "lifetime_hours"
    ],
    "properties": {
      "onprem_public_ip": {
        "type": "string",
        "title": "Your public IP address",
        "_id": "/properties/onprem_public_ip",
        "description": "The public IPv4 address the tunnel comes from (curl ifconfig.me)",
        "maxLength": 15,
        "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}$"
      },
      "enable_nat_gateway": {
        "type": "string",
        "title": "NAT gateway",
        "_id": "/properties/enable_nat_gateway",
        "description": "true also builds the NAT gateway (about $1 a day more); the VPN does not need it",
        "enum": [
          "false",
          "true"
        ],
        "enumNames": [
          "false",
          "true"
        ],
        "default": "false"
      },
      "change_note": {
        "type": "string",
        "title": "Change note",
        "_id": "/properties/change_note",
        "description": "Why, shown to the approver",
        "maxLength": 280
      },
      "lifetime_hours": {
        "type": "string",
        "title": "Lifetime (hours)",
        "_id": "/properties/lifetime_hours",
        "description": "Hours until it is torn down automatically; none keeps it up until Tear Down",
        "enum": [
          "none",
          "2",
          "4",
          "8",
          "24",
          "72"
        ],
        "enumNames": [
          "none",
          "2",
          "4",
          "8",
          "24",
          "72"
        ],
        "default": "8"
      }
    }
  },
