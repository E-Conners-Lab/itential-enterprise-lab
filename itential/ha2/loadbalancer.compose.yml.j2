# The load balancer in front of the Platform nodes (PID S11, ADR 0053). Itential's Deployer documents nginx
# for this role: "listens on port 3443 and forwards requests to port 3000 on the servers ... using sticky
# sessions". Here it listens on 443 with the lab-CA certificate for {{ service_name }}.{{ domain }}, which is
# the name every client already uses, and forwards to {{ platform.http_port }} on both nodes.
services:
  nginx:
    container_name: nginx
    image: {{ images.nginx.repository }}:{{ images.nginx.tag }}
    network_mode: host
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - /opt/itential/tls:/etc/nginx/tls:ro
    healthcheck:
      # nginx.conf binds `listen {{ ip }}:{{ loadbalancer.listen_port }}`, not the wildcard, so a check
      # against 127.0.0.1 is refused (curl exit 7) and the container is marked unhealthy for ever while
      # serving every real request. Check the address it actually listens on.
      test: ["CMD-SHELL", "curl -skf https://{{ ip }}:{{ loadbalancer.listen_port }}/login >/dev/null || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 20s
    restart: unless-stopped

  node-exporter:
    container_name: node-exporter
    image: {{ images.node_exporter.repository }}:{{ images.node_exporter.tag }}
    network_mode: host
    pid: host
    command: ["--path.rootfs=/host", "--web.listen-address={{ ip }}:{{ exporters.node }}"]
    volumes:
      - /:/host:ro,rslave
    restart: unless-stopped
