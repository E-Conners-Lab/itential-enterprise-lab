# The MCP server (PID S11, ADR 0053; Ollama moved to the Mac Mini, ADR 0060). Neither is an Itential Platform component, so the
# guide's "one component per server" rule moves them off the Platform nodes onto their own VM.
services:
  mcp:
    container_name: mcp
    image: {{ images.mcp.repository }}:{{ images.mcp.tag }}
    ports:
      - "{{ ip }}:{{ tools.mcp_port }}:8000"
    environment:
      ITENTIAL_MCP_SERVER_TRANSPORT: "http"
      ITENTIAL_MCP_SERVER_HOST: "0.0.0.0" # the image binds loopback otherwise, and the published port is dead
      ITENTIAL_MCP_SERVER_PORT: "8000"
      ITENTIAL_MCP_SERVER_PATH: "/mcp"
      ITENTIAL_MCP_SERVER_LOG_LEVEL: "INFO"
      # ADR 0039 amendment: the tools that return Inventory Manager node attributes carry the device
      # credentials in their reply, so they are hidden from MCP clients - the same list the dev-stack
      # excludes (itential/compose.override.yml), asserted by verify/test-05 S4.7. ADR 0083: the six adapter and
      # application start/stop/restart tools too, whose roles svc-mcp does not hold (itential/mcp/roles.yaml). Every tool
      # is tagged with its own name, and a hidden tool is refused if called, not only left out of tools/list.
      ITENTIAL_MCP_SERVER_EXCLUDE_TAGS: "experimental,beta,describe_inventory,get_devices,start_adapter,stop_adapter,restart_adapter,start_application,stop_application,restart_application"
      # the load balancer's own name: correct before and after the cut-over
      ITENTIAL_MCP_PLATFORM_HOST: "{{ service_name }}.{{ domain }}"
      ITENTIAL_MCP_PLATFORM_PORT: "{{ loadbalancer.listen_port }}"
      # ADR 0083: its own account (builder without administration, itential/mcp/roles.yaml), never the administrator:
      # itential-mcp has one Platform identity for every caller, so this account is what any MCP client can do
      ITENTIAL_MCP_PLATFORM_USER: "{{ mcp_access.user }}"
      ITENTIAL_MCP_PLATFORM_PASSWORD: ${SVC_MCP_PASSWORD:?}
      # log in again before the Platform's 60-minute idle limit ends the session (versions.yaml tools.mcp_platform_ttl)
      ITENTIAL_MCP_PLATFORM_TTL: "{{ tools.mcp_platform_ttl }}"
      ITENTIAL_MCP_PLATFORM_USE_TLS: "true"
      # the lab CA is trusted system-wide on this VM and mounted for the container
      SSL_CERT_FILE: "/etc/ssl/lab/ca.crt"
    volumes:
      - /opt/itential/tls:/etc/ssl/lab:ro
    restart: unless-stopped

  # the interim directory (ADR 0055): admin@itential and the admins group, from the upstream LDIF
  openldap:
    container_name: openldap
    image: {{ images.ldap.repository }}:{{ images.ldap.tag }}
    command: --copy-service
    ports:
      - "{{ ip }}:{{ ldap.port }}:389"
    volumes:
      - type: bind
        source: ./ldap/openldap.ldif
        target: /container/service/slapd/assets/config/bootstrap/ldif/custom/01-custom-ldap.ldif
    environment:
      LDAP_ORGANISATION: "{{ ldap.organisation }}"
      LDAP_DOMAIN: "{{ ldap.domain }}"
      LDAP_ADMIN_PASSWORD: ${ITENTIAL_ADMIN_PASSWORD:?}
    restart: unless-stopped

  # R7 (ADR 0076 decision 1): Batfish, asked by batfish-check on the Gateway runner before every Hand Off card. Pinned
  # by digest, never :latest. No volume: a snapshot lives only for the answer. Its API has no authentication, so the
  # port is published on the OOB address only and the play's DOCKER-USER allowlist (batfish-access.sh.j2) admits the
  # Gateway VM alone. The heap is capped inside the container's memory limit (measured: ~3 GB at a 2 GB heap).
  batfish:
    container_name: batfish
    image: {{ images.batfish.repository }}@{{ images.batfish.digest }}
    ports:
      - "{{ ip }}:{{ tools.batfish_port }}:9996"
    environment:
      JAVA_TOOL_OPTIONS: "-Xmx{{ tools.batfish_heap }}"
    mem_limit: {{ tools.batfish_memory_limit }}
    restart: unless-stopped

  node-exporter:
    container_name: node-exporter
    image: {{ images.node_exporter.repository }}:{{ images.node_exporter.tag }}
    network_mode: host
    pid: host
    command: ["--path.rootfs=/host", "--web.listen-address={{ ip }}:{{ exporters.node }}"]
    volumes:
      - /:/host:ro,rslave
    restart: unless-stopped
