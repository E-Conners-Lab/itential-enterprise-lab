# The MCP server and the in-lab Ollama (PID S11, ADR 0053). Neither is an Itential Platform component, so the
# guide's "one component per server" rule moves them off the Platform nodes onto their own VM.
services:
  mcp:
    container_name: mcp
    image: {{ images.mcp.repository }}:{{ images.mcp.tag }}
    ports:
      - "{{ ip }}:{{ tools.mcp_port }}:8000"
    environment:
      ITENTIAL_MCP_SERVER_TRANSPORT: "http"
      ITENTIAL_MCP_SERVER_HOST: "0.0.0.0" # the image binds loopback otherwise, and the published port is dead
      ITENTIAL_MCP_SERVER_PORT: "8000"
      ITENTIAL_MCP_SERVER_PATH: "/mcp"
      ITENTIAL_MCP_SERVER_LOG_LEVEL: "INFO"
      # the load balancer's own name: correct before and after the cut-over
      ITENTIAL_MCP_PLATFORM_HOST: "{{ service_name }}.{{ domain }}"
      ITENTIAL_MCP_PLATFORM_PORT: "{{ loadbalancer.listen_port }}"
      ITENTIAL_MCP_PLATFORM_USER: ${ITENTIAL_ADMIN_USER:-admin@itential}
      ITENTIAL_MCP_PLATFORM_PASSWORD: ${ITENTIAL_ADMIN_PASSWORD:?}
      ITENTIAL_MCP_PLATFORM_USE_TLS: "true"
      # the lab CA is trusted system-wide on this VM and mounted for the container
      SSL_CERT_FILE: "/etc/ssl/lab/ca.crt"
    volumes:
      - /opt/itential/tls:/etc/ssl/lab:ro
    restart: unless-stopped

  ollama:
    container_name: ollama
    image: {{ images.ollama.repository }}:{{ images.ollama.tag }}
    ports:
      - "{{ ip }}:{{ tools.ollama_port }}:11434"
    volumes:
      - ollama-models:/root/.ollama
    environment:
      OLLAMA_KEEP_ALIVE: "30m"
      OLLAMA_NUM_PARALLEL: "1"
      OLLAMA_MAX_LOADED_MODELS: "1"
      OLLAMA_CONTEXT_LENGTH: "16384" # a fleet-wide tool result must fit the local model's context (ADR 0046)
    deploy:
      resources:
        limits:
          memory: 6g
    restart: unless-stopped

  node-exporter:
    container_name: node-exporter
    image: {{ images.node_exporter.repository }}:{{ images.node_exporter.tag }}
    network_mode: host
    pid: host
    command: ["--path.rootfs=/host", "--web.listen-address={{ ip }}:{{ exporters.node }}"]
    volumes:
      - /:/host:ro,rslave
    restart: unless-stopped

volumes:
  ollama-models:
