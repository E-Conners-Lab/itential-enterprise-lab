# gNMIc (ADR 0051 decision 8): one Deployment subscribing to the vEOS fabric, Prometheus output on 9273.
# The configuration comes from observability/gnmic/gnmic.yaml.j2 with the targets from NetBox.
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: gnmic
  namespace: {{ obs_namespace }}
data:
  gnmic.yaml: |
{{ gnmic_config | indent(4, true) }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: gnmic
  namespace: {{ obs_namespace }}
  labels:
    app.kubernetes.io/name: gnmic
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: gnmic
  template:
    metadata:
      labels:
        app.kubernetes.io/name: gnmic
      annotations:
        checksum/config: "{{ gnmic_config | hash('sha256') }}"
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 65534
        runAsGroup: 65534
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: gnmic
          image: {{ components.gnmic.image }}:{{ components.gnmic.image_tag }}
          args: ["subscribe", "--config", "/app/config/gnmic.yaml"]
          envFrom:
            - secretRef: {name: gnmic}
          ports:
            - {name: metrics, containerPort: 9273}
          volumeMounts:
            - {name: config, mountPath: /app/config, readOnly: true}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          resources:
            requests: {cpu: 50m, memory: 96Mi}
            limits: {memory: 384Mi}
          readinessProbe:
            httpGet: {path: /metrics, port: metrics}
            initialDelaySeconds: 10
            periodSeconds: 15
      volumes:
        - name: config
          configMap: {name: gnmic}
---
apiVersion: v1
kind: Service
metadata:
  name: gnmic
  namespace: {{ obs_namespace }}
  labels:
    app.kubernetes.io/name: gnmic
spec:
  selector:
    app.kubernetes.io/name: gnmic
  ports:
    - {name: metrics, port: 9273, targetPort: metrics}
