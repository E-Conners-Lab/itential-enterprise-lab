# Managed by ansible/playbooks/oob-gw.yml. Interim resolver until phase 6 (ADR 0008/0009).
server:
  interface: 127.0.0.1
  interface: {{ oob_gw_ip }}
  interface: {{ ansible_facts.default_ipv4.address }}
  access-control: 127.0.0.0/8 allow
  access-control: {{ lab_supernet }} allow
  access-control: 192.168.68.0/22 allow
  do-not-query-localhost: no
  local-zone: "{{ domain }}." static
{% for a in addresses %}
  local-data: "{{ a.hostname }}.{{ domain }}. A {{ a.address }}"
  local-data-ptr: "{{ a.address }} {{ a.hostname }}.{{ domain }}"
{% for alias in a.aliases | default([]) %}
  local-data: "{{ alias }}.{{ domain }}. A {{ a.address }}"
{% endfor %}
{% endfor %}
{% if home_lan.inference_host is defined %}
  # The inference host is on the home LAN, not the lab (ADR 0060): ollama.lab.internal answers here.
  local-data: "{{ home_lan.inference_host.hostname }}.{{ domain }}. A {{ home_lan.inference_host.address }}"
{% for alias in home_lan.inference_host.aliases | default([]) %}
  local-data: "{{ alias }}.{{ domain }}. A {{ home_lan.inference_host.address }}"
{% endfor %}
{% endif %}

forward-zone:
  name: "."
  forward-addr: {{ home_router }}
