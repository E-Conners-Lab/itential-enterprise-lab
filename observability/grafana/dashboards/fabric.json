{
 "uid": "lab-fabric",
 "title": "Fabric",
 "description": "PID S7: the vEOS fabric through gNMIc (BGP session state, interface counters).",
 "tags": [
  "lab"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "title": "BGP sessions Established (gNMIc)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count by (source) ({__name__=~\"gnmic_bgp.*session_state\", session_state=\"ESTABLISHED\"})",
     "legendFormat": "{{source}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 2,
   "title": "BGP sessions not Established",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 6
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "{__name__=~\"gnmic_bgp.*session_state\", session_state!=\"ESTABLISHED\"}",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "transformations": [
    {
     "id": "labelsToFields"
    }
   ]
  },
  {
   "id": 3,
   "title": "Interface in octets/s (gNMIc)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate({__name__=~\"gnmic_interfaces.*in_octets\"}[2m]) * 8",
     "legendFormat": "{{source}} {{interface_name}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "title": "Interface out octets/s (gNMIc)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 11,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate({__name__=~\"gnmic_interfaces.*out_octets\"}[2m]) * 8",
     "legendFormat": "{{source}} {{interface_name}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 5,
   "title": "Interface errors (gNMIc, 5 m increase)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "increase({__name__=~\"gnmic_interfaces.*(in|out)_errors\"}[5m])",
     "legendFormat": "{{source}} {{interface_name}} {{__name__}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  }
 ]
}
