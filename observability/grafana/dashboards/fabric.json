{
 "uid": "lab-fabric",
 "title": "Fabric",
 "description": "PID S7: the vEOS fabric through gNMIc (interface counters) and every declared BGP session, gNMIc on vEOS and SNMP on the C8000v routers (R10).",
 "tags": [
  "lab"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "title": "BGP sessions Established per router (gNMIc + SNMP)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (device) (lab:bgp_session_up)",
     "legendFormat": "{{device}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 2,
   "title": "BGP sessions not Established (declared in the topology)",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 6
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "lab:bgp_session_up == 0",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "Value": true
      },
      "indexByName": {
       "device": 0,
       "neighbor": 1,
       "peer": 2,
       "vrf": 3,
       "remote_as": 4,
       "pair": 5
      }
     }
    }
   ],
   "description": "Every declared session end that is not Established right now (instant query): one row each."
  },
  {
   "id": 3,
   "title": "Interface in octets/s (gNMIc)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate({__name__=~\"gnmic_interfaces.*in_octets\"}[2m]) * 8",
     "legendFormat": "{{source}} {{interface_name}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "title": "Interface out octets/s (gNMIc)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 11,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate({__name__=~\"gnmic_interfaces.*out_octets\"}[2m]) * 8",
     "legendFormat": "{{source}} {{interface_name}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 5,
   "title": "Interface errors (gNMIc, 5 m increase)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "increase({__name__=~\"gnmic_interfaces.*in_errors\"}[5m])",
     "legendFormat": "{{source}} {{interface_name}} in",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "increase({__name__=~\"gnmic_interfaces.*out_errors\"}[5m])",
     "legendFormat": "{{source}} {{interface_name}} out",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "description": "In and out errors as two queries: increase() drops the metric name, so one query over both collided on the same label set and the panel errored."
  }
 ]
}
