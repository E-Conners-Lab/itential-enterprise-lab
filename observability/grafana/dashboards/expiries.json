{
 "uid": "lab-expiries",
 "title": "Expiries",
 "description": "PID S7: every evaluation, licence, token and certificate expiry from observability/expiries.yaml, through the Zabbix datasource.",
 "tags": [
  "lab"
 ],
 "timezone": "utc",
