    "type": "alexanderzobnin-zabbix-datasource",
    "uid": "zabbix"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "alexanderzobnin-zabbix-datasource",
      "uid": "zabbix"
     },
     "refId": "A",
     "queryType": "0",
     "group": {
      "filter": "lab/synthetic"
     },
     "host": {
      "filter": "expiries"
     },
     "application": {
      "filter": ""
     },
     "item": {
      "filter": "/.*/"
     },
     "functions": []
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "d",
     "min": 0,
     "max": 400,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 14
       },
       {
        "color": "green",
        "value": 60
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "orientation": "horizontal",
    "displayMode": "gradient"
   }
  },
