{
 "uid": "lab-expiries",
 "title": "Expiries",
 "description": "PID S7: every evaluation, licence, token and certificate expiry from observability/expiries.yaml, through the lab:expiry_days_left series of the generated PrometheusRule lab-expiries (ADR 0071).",
 "tags": [
  "lab"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "title": "Days left per expiry",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "lab:expiry_days_left",
     "instant": true,
     "legendFormat": "{{name}} ({{expires}})"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "d",
     "min": 0,
     "max": 400,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 14
       },
       {
        "color": "green",
        "value": 60
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "orientation": "horizontal",
    "displayMode": "gradient"
   }
  },
  {
   "id": 2,
   "title": "Days left over time",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "lab:expiry_days_left",
     "legendFormat": "{{name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "d"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "title": "Expiry alerts (LabExpirySoon)",
   "type": "alertlist",
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 24,
    "h": 7
   },
   "options": {
    "alertName": "LabExpirySoon",
    "showOptions": "current",
    "maxItems": 20,
    "stateFilter": {
     "firing": true,
     "pending": true,
     "normal": false
    },
    "alertInstanceLabelFilter": "",
    "datasource": "prometheus"
   }
  }
 ]
}
